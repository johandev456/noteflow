{
  "name": "noteflow",
  "description": "Chrome extension: live tab-audio transcription, AI-structured notes, Notion export",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
